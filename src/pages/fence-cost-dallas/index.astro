          <th style="background:#2A3035;color:#fff;padding:13px 16px;text-align:left;font-weight:700;">Typical Range</th>
          <th style="background:#2A3035;color:#fff;padding:13px 16px;text-align:left;font-weight:700;">Notes</th>
        </tr></thead>
