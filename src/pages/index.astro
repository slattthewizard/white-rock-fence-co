<!-- WHY -->
<section style="padding:84px 24px;background:#fff;">
  <div class="why-grid" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.1fr 0.9fr;gap:64px;align-items:center;">
    <div>
      <span class="kicker">What Makes Us Different</span>
      <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,40px);margin:0 0 28px;">What you get when you start with White Rock Fence Co</h2>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:20px;">
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2E6B47" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Inter',sans-serif;font-size:17px;font-weight:800;color:#2A3035;margin:0 0 4px;">The contractor who quotes is independent</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5B5F62;margin:0;">This site is advertising, not a fence crew. The independent contractor who answers your request puts the quote in writing, and you decide whether to hire them.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2E6B47" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Inter',sans-serif;font-size:17px;font-weight:800;color:#2A3035;margin:0 0 4px;">Every price is named and attributed</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5B5F62;margin:0;">Figures here are what one Dallas-area firm advertises, or what a national guide reports, and we say which. Nothing on the page is a quote for your fence.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2E6B47" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Inter',sans-serif;font-size:17px;font-weight:800;color:#2A3035;margin:0 0 4px;">City rules come from the City</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5B5F62;margin:0;">Dallas's own permit checklist says a permit is required above 4 feet in a front yard or 6 feet anywhere else, with a 9-foot maximum. We point you to the source so you can confirm it with the City and your HOA.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2E6B47" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Inter',sans-serif;font-size:17px;font-weight:800;color:#2A3035;margin:0 0 4px;">Suburb rules are not Dallas rules</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5B5F62;margin:0;">Plano, Garland, Richardson, Mesquite, Irving and Carrollton each publish their own permit triggers and height limits. Each suburb page linked below sets out what that city's handout says.</p>
            </div>
          </li>
      </ul>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;">
      <div style="border-radius:18px;overflow:hidden;box-shadow:0 18px 44px rgba(10,61,92,0.2);aspect-ratio:4/5;">
        <img src="/images/hero-800.webp" alt="White Rock Fence Co at work" width="800" height="800" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div style="background:#A8551F;border-radius:20px;padding:24px;text-align:center;">
          <p style="font-family:'Inter',sans-serif;font-size:26px;font-weight:800;color:#fff;margin:0;line-height:1;">2-3</p>
