  .rich li { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 8px; }
  .rich strong { color: #2F3438; }
  .rich a { color: #A8551F; font-weight: 600; text-decoration: none; }
  .rich a:hover { text-decoration: underline; }
</style>
</Fragment>

<!-- HERO -->
<section style="position:relative;min-height:560px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;">
  <img src="/images/hero-panorama.webp" alt="Dallas landscape" width="2000" height="950" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" fetchpriority="high">
  <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,61,92,0.55) 0%, rgba(10,61,92,0.25) 55%, rgba(10,61,92,0.45) 100%);"></div>
  <div style="position:relative;max-width:880px;padding:96px 24px 130px;">
    <span style="display:inline-block;margin-bottom:18px;padding:7px 18px;border-radius:999px;font-family:'Inter',sans-serif;font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;background:rgba(255,255,255,0.14);color:#fff;border:1px solid rgba(255,255,255,0.35);backdrop-filter:blur(3px);">Independent Contractors · Dallas &amp; Suburbs</span>
    <h1 style="font-family:'Inter',sans-serif;font-weight:800;color:#fff;line-height:1.08;letter-spacing:-0.015em;font-size:clamp(32px,5vw,58px);margin:0 0 18px;text-shadow:0 2px 24px rgba(10,61,92,0.45);">Fence Installation in Dallas, TX, Quoted by Independent Fence Contractors</h1>
    <p style="font-size:18px;line-height:1.7;color:rgba(255,255,255,0.92);max-width:640px;margin:0 auto 30px;text-shadow:0 1px 12px rgba(10,61,92,0.5);">White Rock Fence Co advertises independent fence contractors for wood privacy fences, repairs, gates and iron fencing in Dallas, Plano, Garland, Richardson, Mesquite, Irving and Carrollton. Call (214) 555-0137 or email info@whiterockfenceco.com and your request goes to an independent contractor who sends a written quote, and we suggest you compare two or three.</p>
    <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
      <a href="tel:+12145550137" class="btn-green" style="font-size:15px;padding:16px 38px;">Call Now — (214) 555-0137</a>
      <a href="/#contact" class="btn-white-outline" style="font-size:15px;">Get a Written Quote</a>
    </div>
  </div>
  <svg class="swoosh" style="position:absolute;bottom:0;left:0;" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0,70 C360,10 1080,10 1440,70 L1440,70 L0,70 Z" fill="#ffffff"/></svg>
</section>

<!-- INTRO -->
<section style="padding:84px 24px 64px;background:#fff;">
  <div class="intro-grid" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:center;">
    <div style="position:relative;">
      <div style="border-radius:18px;overflow:hidden;box-shadow:0 24px 56px rgba(10,61,92,0.22);aspect-ratio:1/1;">
